{
  "manifest_version": 3,
  "name": "Blimp: importar do HUB SEBRAE",
  "description": "Quando você pede no Blimp, lê a página do pedido que está aberta no HUB e entrega o texto ao Blimp. Só lê o site que você permitir.",
  "version": "1.0.0",
  "key": "",
  "minimum_chrome_version": "111",
  "permissions": ["scripting", "storage"],
  "optional_host_permissions": ["https://*/*"],
  "background": { "service_worker": "fundo.js" },
  "options_ui": { "page": "opcoes.html", "open_in_tab": true },
  "action": { "default_title": "Blimp: importar do HUB", "default_popup": "opcoes.html" },
  "externally_connectable": { "matches": ["https://sistema-de-gestao-alpha.vercel.app/*"] }
}

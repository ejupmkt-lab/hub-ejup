{
  "manifest_version": 3,
  "name": "Blimp: importar do HUB SEBRAE",
  "description": "Com um clique na extensão, lê a página do HUB que você está vendo, baixa os anexos e leva tudo para o projeto aberto no Blimp.",
  "version": "1.7.0",
  "key": "",
  "minimum_chrome_version": "111",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "https://sistema-de-gestao-alpha.vercel.app/*"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ],
  "background": {
    "service_worker": "fundo.js"
  },
  "options_ui": {
    "page": "opcoes.html",
    "open_in_tab": true
  },
  "action": {
    "default_title": "Blimp: ler esta página do HUB",
    "default_popup": "popup.html"
  },
  "externally_connectable": {
    "matches": [
      "https://sistema-de-gestao-alpha.vercel.app/*"
    ]
  },
  "optional_permissions": [
    "debugger"
  ]
}
